# Copy to .env and fill in your own values. Never commit .env.
DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
CLIENT_ID=PUT_YOUR_APPLICATION_ID_HERE
GUILD_ID=PUT_YOUR_TEST_SERVER_ID_HERE
BOT_OWNER_IDS=
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info

# Optional Herade Core Minecraft integration.
# Use the same random secret (at least 32 UTF-8 bytes) in the Minecraft server environment.
HERADE_CORE_API_TOKEN=
# Bind to loopback when a TLS reverse proxy runs on the same host.
HERADE_CORE_API_HOST=127.0.0.1
HERADE_CORE_API_PORT=3068
